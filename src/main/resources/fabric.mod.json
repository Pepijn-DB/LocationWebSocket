{
	"schemaVersion": 1,
	"id": "locationwebsocket",
	"version": "${version}",
	"name": "LocationWebSocket",
	"description": "A Fabric mod that sends all player location data to a WebSocket server.",
	"authors": [
		"Pepijn Bookelaar"
	],
	"contact": {
		"homepage": "https://locationwebsocket.fabric.nyxz.nl/",
		"sources": "https://github.com/Pepijn-DB/LocationWebSocket"
	},
	"license": "Apache-2.0",
	"icon": "assets/locationwebsocket/icon.png",
	"environment": "server",
	"entrypoints": {
		"main": [
          "com.nyxz.fabric.locationwebsocket.LocationWebSocket"
		]
	},
	"mixins": [
		"locationwebsocket.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.1",
		"minecraft": "~1.21.10",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}
